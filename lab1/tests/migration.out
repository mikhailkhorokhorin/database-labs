SELECT
    i.rental_id,
    i.kind,
    count(d.incident_id) AS incidents
FROM rental_inspection AS i
LEFT JOIN rental_incident AS d ON i.inspection_id = d.inspection_id
GROUP BY i.inspection_id, i.rental_id, i.kind
ORDER BY i.inspection_id;
